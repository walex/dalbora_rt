#pragma enable_d3d11_debug_symbols

struct RayPayload
{
    float4 color;
};

struct Attributes
{
    float2 barycentrics;
};

RWTexture2D<float4> Output : register(u0);
RaytracingAccelerationStructure SceneBVH : register(t0);

cbuffer CameraCB : register(b0)
{
    float4 camera_pos;
    float4 camera_forward;
    float4 camera_right;
    float4 camera_up;

    float tanHalfFov;
    float aspect;
    float2 padding;
};

[shader("raygeneration")]
void RayGen()
{
	
	///////////////////////////////////////////////////////////////////////////////
	// 1. ¿Qué pixel me tocó procesar?
	///////////////////////////////////////////////////////////////////////////////

	uint2 pixel = DispatchRaysIndex().xy;


	///////////////////////////////////////////////////////////////////////////////
	// 2. ¿Cuál es el tamaño total de la imagen?
	///////////////////////////////////////////////////////////////////////////////

	uint2 resolution = DispatchRaysDimensions().xy;


	///////////////////////////////////////////////////////////////////////////////
	// 3. Convertir el índice entero del pixel a float
	///////////////////////////////////////////////////////////////////////////////

	float2 pixelPosition = float2(pixel);


	///////////////////////////////////////////////////////////////////////////////
	// 4. Movernos al centro del pixel
	//
	// Cada pixel representa un área.
	//
	// (10,20) representa la esquina superior izquierda.
	//
	// Queremos disparar el rayo desde el centro:
	//
	//      +---------+
	//      |         |
	//      |    X    |
	//      |         |
	//      +---------+
	//
	// Por eso sumamos 0.5
	///////////////////////////////////////////////////////////////////////////////

	float2 pixelCenter =
		pixelPosition + 0.5;


	///////////////////////////////////////////////////////////////////////////////
	// 5. Normalizar las coordenadas.
	//
	// Pasamos de:
	//
	//      0 .... ancho
	//
	// a
	//
	//      0 .... 1
	///////////////////////////////////////////////////////////////////////////////

	float2 normalizedScreen =
		pixelCenter / float2(resolution);


	///////////////////////////////////////////////////////////////////////////////
	// 6. Cambiar el rango.
	//
	// Pasamos de:
	//
	//      0 ..... 1
	//
	// a
	//
	//     -1 ..... 1
	//
	// El centro de la pantalla ahora vale (0,0)
	///////////////////////////////////////////////////////////////////////////////

	float2 screen =
		normalizedScreen * 2.0 - 1.0;


	///////////////////////////////////////////////////////////////////////////////
	// 7. Corregir la relación ancho/alto.
	//
	// Si la pantalla es 1920x1080,
	// el eje X debe ser más grande que el eje Y.
	//
	// Si no hacemos esto,
	// la imagen aparece estirada.
	///////////////////////////////////////////////////////////////////////////////

	float x =
		screen.x * aspect;


	///////////////////////////////////////////////////////////////////////////////
	// 8. Invertir el eje Y.
	//
	// Las imágenes normalmente tienen:
	//
	// (0,0)
	//
	// arriba
	//
	// mientras que en 3D queremos:
	//
	// +Y
	//
	// hacia arriba.
	///////////////////////////////////////////////////////////////////////////////

	float y =
		-screen.y;


	///////////////////////////////////////////////////////////////////////////////
	// 9. Escalar por el Field Of View.
	//
	// tan(FOV/2)
	//
	// determina el tamaño del plano de imagen.
	///////////////////////////////////////////////////////////////////////////////

	x *= tanHalfFov;
	y *= tanHalfFov;


	///////////////////////////////////////////////////////////////////////////////
	// 10. Construir el desplazamiento horizontal.
	//
	// camera_right es un vector unitario
	// apuntando hacia la derecha de la cámara.
	///////////////////////////////////////////////////////////////////////////////

	float3 horizontalOffset =
		x * camera_right;


	///////////////////////////////////////////////////////////////////////////////
	// 11. Construir el desplazamiento vertical.
	///////////////////////////////////////////////////////////////////////////////

	float3 verticalOffset =
		y * camera_up;


	///////////////////////////////////////////////////////////////////////////////
	// 12. El centro del plano de imagen está delante
	// de la cámara.
	///////////////////////////////////////////////////////////////////////////////

	float3 imagePlaneCenter =
		camera_forward;


	///////////////////////////////////////////////////////////////////////////////
	// 13. Obtener el punto correspondiente del plano
	// para este pixel.
	///////////////////////////////////////////////////////////////////////////////

	float3 pointOnImagePlane =
		imagePlaneCenter +
		horizontalOffset +
		verticalOffset;


	///////////////////////////////////////////////////////////////////////////////
	// 14. Ese vector todavía no tiene longitud 1.
	//
	// Sólo nos interesa la dirección.
	///////////////////////////////////////////////////////////////////////////////

	float3 ray_dir =
    normalize(pointOnImagePlane);
	
    RayDesc ray;
    ray.Origin = camera_pos;
    ray.Direction = ray_dir;
    ray.TMin = 0.001;
    ray.TMax = 10000.0;

    RayPayload payload;
    payload.color = float4(0, 0, 0, 1);

    TraceRay(
        SceneBVH,
        RAY_FLAG_NONE,
        0xFF,
        0, // ray contribution
        0, // multiplier
        0, // miss shader index
        ray,
        payload
    );

    Output[pixel] = payload.color;
	
}

[shader("miss")]
void Miss(inout RayPayload payload)
{
    payload.color = float4(0.1, 0.2, 0.4, 1.0);
}

[shader("closesthit")]
void ClosestHit(
    inout RayPayload payload,
    in Attributes attribs)
{
    payload.color = float4(0.0, 1.0, 0.0, 1.0);
}